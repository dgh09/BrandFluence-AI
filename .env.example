# Copia este fichero a .env.local y rellena los valores.
# .env.local está en .gitignore — nunca lo subas.

# ---------------------------------------------------------------------------
# Base de datos — Supabase
# ---------------------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string > "Transaction pooler"
# OJO: puerto 6543 (pooler), NO 5432. En serverless el pooler es obligatorio.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase > Project Settings > API
# Las tres hacen falta para subir ficheros (avatares, logos y contenido
# entregado). Después de rellenarlas: node scripts/check-storage.mjs --setup
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
# La usa el navegador para subir con el permiso firmado que da /api/uploads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Solo servidor. Salta el RLS — nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# NextAuth v5
# ---------------------------------------------------------------------------
# Genera con: npx auth secret     (o: openssl rand -base64 32)
AUTH_SECRET=""

# En local no hace falta. En Vercel: https://tudominio.com
# AUTH_URL="https://brandfluence.ai"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Servicios externos (aún no usados — semanas 3-4)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SENDGRID_API_KEY=""

# --- Matching -----------------------------------------------------------
# Token del endpoint de recálculo /api/matches/regenerate.
# Sin él la ruta devuelve 503 (falla cerrada, no abierta).
MATCHING_ADMIN_TOKEN=""
